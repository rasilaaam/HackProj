# Auto detect text files and normalize line endings to LF
* text=auto

# Python files
*.py text eol=lf
*.pyi text eol=lf
*.pyc binary

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# SQL files
*.sql text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Documentation
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf

# Configuration
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf

# Git attributes
.gitattributes text eol=lf
.gitignore text eol=lf

# Database files
*.db binary
*.sqlite binary
*.sqlite3 binary

# Archives
*.zip binary
*.gz binary
*.tar binary
*.7z binary

# Raw data files (preserve exact bytes)
data/raw/** -text

# Images
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.svg text eol=lf
*.ico binary

# Nix
shell.nix text eol=lf
flake.nix text eol=lf
*.nix text eol=lf
